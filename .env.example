NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Segundo paso del login: frase de acceso de 10 palabras (solo guardamos su hash, formato scrypt.<sal>.<hash>, sin dolares).
# Genera la línea con: node scripts/hash-passphrase.mjs  (la frase se escribe por stdin)
LOGIN_PASSPHRASE_HASH=
# Clave para firmar las cookies del segundo paso. Genera una con: openssl rand -base64 32
LOGIN_2FA_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# El propietario pone aquí su email real en .env.local y en las variables de Vercel.
VAPID_SUBJECT=mailto:tu-email@example.com
# Clave de Google AI Studio (aistudio.google.com/apikey). GEMINI_MODEL es opcional.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=
# Solo para tests/rls.test.ts (proyecto Supabase de pruebas o el de desarrollo)
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
